# ============================================
# BalanceHub — Тохиргооны файл
# ============================================
# Энэ файлыг .env.local гэж ХУУЛЖ нэрлээд
# доорх утгуудыг өөрийнхөөрөө сольно.
# ============================================

# Anthropic AI (console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-ЭНДДОО_ӨӨРИЙН_KEY_ТАВИХ

# Supabase (supabase.com → Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxx

# QPay (merchant.qpay.mn → данснаас авна)
QPAY_USERNAME=your_merchant_username
QPAY_PASSWORD=your_merchant_password
QPAY_INVOICE_CODE=your_invoice_code

# Сайтын хаяг (deploy хийсний дараа солих)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
